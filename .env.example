# Copy to .env.local for local development. Never commit real secrets.
# Generate AUTH_SECRET:
#   $b = New-Object byte[] 32
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   "AUTH_SECRET=" + [Convert]::ToBase64String($b)
#
# Client secret (not the Secret ID):
#   az keyvault secret show --vault-name kv-sd-dev-aue --name entra-client-secret --query value -o tsv
#
# Local SQL: Azure SQL Dev (sql-sd-dev-aue / sqldb-sd) via API user-secrets — no Docker.

AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
API_BASE_URL=http://127.0.0.1:5101
API_SCOPE=api://cf004c78-017b-4aed-b258-8cd451d401e7/Requests.Access
ENTRA_TENANT_ID=e65ccc1d-c4c1-485f-8647-f97226d04ed1
ENTRA_CLIENT_ID=1f184cd6-fd3a-4f18-8592-0ee0d94c8408
ENTRA_CLIENT_SECRET=

# Optional — real Stripe test keys. Leave blank to use the in-app dummy Stripe Pay step.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# MVP online-ordering deep-link clinic (SeedRunner uses demo-clinic-a).
NEXT_PUBLIC_DEFAULT_CLINIC_SLUG=demo-clinic-a

# Frontend-only mode (no .NET API). Defaults on in development when AUTH_SECRET
# is unset. Set to 0 to force live API + Entra for HQ.
# STATIC_DEMO=1

# Optional extra CSP img-src hosts (space-separated). https: is already allowed
# for clinic logos; use this only if you need http: or a specific scheme.
# CSP_IMG_SRC_EXTRA=

